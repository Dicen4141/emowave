# Copy this file to .env.local and fill in your real key.
# NOTE: DATABASE_URL does NOT go here — Prisma's CLI only reads it from
# `.env` in the project root (not `.env.local`), so it lives there instead.
# See .env for that.
GEMINI_API_KEY=your-gemini-key-here

# Supabase Auth — from the "Connect" panel → Framework tab (NOT the ORM
# tab you used for DATABASE_URL). These are safe to be public/client-side.
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Service-role key for the SAME Supabase project above — server-only, see
# lib/quantemo.ts and scripts/create-admin.mjs.
QUANTEMO_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Shared secret for Quantemo's Database Webhook on the `orders` table —
# see app/api/webhooks/quantemo-order for the one-time dashboard setup.
QUANTEMO_WEBHOOK_SECRET=generate-a-random-string-here
